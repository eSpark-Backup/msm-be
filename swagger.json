{
  "openapi": "3.0.0",
  "info": {
    "title": "Device Verification API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.stg.eincloud.ai/api"
    },
    {
      "url": "https://api.eincloud.ai/api"
    }
  ],
  "paths": {
    "/devices/verify": {
      "post": {
        "summary": "Verify and register device using UUID, IMEI and password",
        "tags": ["Devices"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["device_uuid", "device_imei", "device_pass"],
                "properties": {
                  "device_uuid": {
                    "type": "string"
                  },
                  "device_imei": {
                    "type": "string"
                  },
                  "device_pass": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "device_uuid": "ESP90000005",
                "device_imei": "865788062388016",
                "device_pass": "abc123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Device registered successfully",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "error_code": 200,
                  "message": "Registered",
                  "data": {
                    "_id": "68f74777bf4d7df787ad801e",
                    "device_uuid": "ESP90000005",
                    "device_imei": "865788062388016",
                    "device_status": false,
                    "mqtt_status": true,
                    "sftp_status": false,
                    "gsm_status": "false",
                    "ntp_status": "true",
                    "device_ip": "10.99.72.185",
                    "device_pass": "8a7b0352f39a6ff6ea575939d040fc2b:028ff3e6b136c95aa138dde7413448ba",
                    "createdAt": "2025-10-21T08:42:31.233Z",
                    "updatedAt": "2025-11-28T10:54:59.177Z",
                    "mqtt": [],
                    "mqtts": [],
                    "ntp": [],
                    "sftp": [],
                    "ota": [],
                    "measurements": []
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing required fields",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error_code": 400,
                  "message": "Missing required fields"
                }
              }
            }
          },
          "401": {
            "description": "Wrong password",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error_code": 401,
                  "message": "Unauthorized"
                }
              }
            }
          },
          "404": {
            "description": "Device UUID does not exist",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error_code": 404,
                  "message": "Device Not Exists"
                }
              }
            }
          },
          "409": {
            "description": "IMEI already registered",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error_code": 409,
                  "message": "Device Already Registered"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error_code": 500,
                  "message": "Internal Server Error"
                }
              }
            }
          }
        }
      }
    }
  }
}
